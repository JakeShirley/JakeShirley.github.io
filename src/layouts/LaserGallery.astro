---
import type { CollectionEntry } from "astro:content";
import Base from "./Base.astro";

type Props = CollectionEntry<"laserWorks">["data"];

const { title, description, image, mediaPath, media } = Astro.props;
const firstPhotoIndex = media.findIndex((item) => item.type === "photo");
---

<Base title={title} description={description} image={image}>
  <p><a href="/#laser-works">Laser Works</a></p>
  <h1>{title}</h1>
  <slot />
  {media.map((item, index) => (
    <figure>
      {item.type === "video" ? (
        <video
          controls
          preload="metadata"
          playsinline
          width={item.width}
          height={item.height}
          poster={`${mediaPath}/${item.name}-poster.jpg`}
          aria-label={item.label}
        >
          <source src={`${mediaPath}/${item.name}.mp4`} type="video/mp4" />
          <a href={`${mediaPath}/${item.name}.mp4`}>{item.linkText}</a>
        </video>
      ) : (
        <a href={`${mediaPath}/${item.name}.jpg`}>
          <img
            src={`${mediaPath}/${item.name}-preview.jpg`}
            alt={item.alt}
            width={item.width}
            height={item.height}
            loading={index === firstPhotoIndex ? "eager" : "lazy"}
            decoding="async"
          />
        </a>
      )}
      {item.caption && <figcaption>{item.caption}</figcaption>}
    </figure>
  ))}
</Base>

<style>
  figcaption {
    text-align: center;
  }
</style>