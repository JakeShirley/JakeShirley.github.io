---
import Base from "../../layouts/Base.astro";

const photos = [
  {
    name: "img_1500",
    alt: "Navy and coral handled bottles engraved with the names Junior and Henley.",
    width: 960,
    height: 1280,
  },
  {
    name: "img_1501",
    alt: "Close-up of a navy YETI bottle engraved with the name Junior.",
    width: 960,
    height: 1280,
  },
  {
    name: "img_1905",
    alt: "Red insulated mugs engraved with the Mojang Studios logo.",
    width: 1280,
    height: 960,
  },
  {
    name: "img_8784",
    alt: "A row of colorful tumblers, each engraved with a different name.",
    width: 1280,
    height: 960,
  },
  {
    name: "img_9251",
    alt: "White and black tumblers engraved with Mrs. and Mr. Hopkins and a wedding date.",
    width: 960,
    height: 1280,
  },
];
const mediaPath = "/media/laser-works/tumblers";
---

<Base title="Tumblers" description="A gallery of Jake Shirley's laser-engraved tumblers." image={`${mediaPath}/img_1500.jpg`}>
  <p><a href="/#laser-works">Laser Works</a></p>
  <h1>Tumblers</h1>
  <p>Engraving Yeti (and other cheaper brands) of tumblers/mugs/etc. Generally done with the <a href="https://lensdigital.com/blogs/articles/introducing-piburn-4-0-the-latest-and-greatest-rotary-from-lensdigital">PiBurn 4.0</a> rotary attachment.</p>
  <figure>
    <video
      controls
      preload="metadata"
      playsinline
      width="720"
      height="1280"
      poster={`${mediaPath}/img_1499-poster.jpg`}
      aria-label="Laser engraving a coral bottle on a rotary attachment"
    >
      <source src={`${mediaPath}/img_1499.mp4`} type="video/mp4" />
      <a href={`${mediaPath}/img_1499.mp4`}>Watch the laser engraving video</a>
    </video>
  </figure>
  {photos.map((photo, index) => (
    <figure>
      <a href={`${mediaPath}/${photo.name}.jpg`}>
        <img
          src={`${mediaPath}/${photo.name}-preview.jpg`}
          alt={photo.alt}
          width={photo.width}
          height={photo.height}
          loading={index === 0 ? "eager" : "lazy"}
          decoding="async"
        />
      </a>
    </figure>
  ))}
</Base>