---
import { getCollection, render, type CollectionEntry } from "astro:content";
import LaserGallery from "../../layouts/LaserGallery.astro";

export async function getStaticPaths() {
  const galleries = await getCollection("laserWorks");
  return galleries.map((gallery) => ({ params: { id: gallery.id }, props: { gallery } }));
}

interface Props {
  gallery: CollectionEntry<"laserWorks">;
}

const { gallery } = Astro.props;
const { Content } = await render(gallery);
---

<LaserGallery {...gallery.data}>
  <Content />
</LaserGallery>